# ────────────────────────────────────
# Railway PostgreSQL
# ────────────────────────────────────
DB_URL=jdbc:postgresql://zephyr.proxy.rlwy.net:57437/railway
DB_USERNAME=postgres
DB_PASSWORD=<your_password>

# ────────────────────────────────────
# JPA / HikariCP
# ────────────────────────────────────
JPA_SHOW_SQL=true
HIKARI_MAX_POOL_SIZE=5
HIKARI_MIN_IDLE=2

# ────────────────────────────────────
# JWT
# 생성 방법: openssl rand -base64 64
# ────────────────────────────────────
JWT_SECRET_KEY=<base64_encoded_secret>
JWT_EXPIRATION_TIME=86400000
JWT_REFRESH_EXPIRATION_TIME=604800000

# ────────────────────────────────────
# OAuth2 - Google
# https://console.cloud.google.com
# ────────────────────────────────────
GOOGLE_CLIENT_ID=<google_client_id>
GOOGLE_CLIENT_SECRET=<google_client_secret>

# ────────────────────────────────────
# OAuth2 - Naver
# https://developers.naver.com
# ────────────────────────────────────
NAVER_CLIENT_ID=<naver_client_id>
NAVER_CLIENT_SECRET=<naver_client_secret>

# ────────────────────────────────────
# OAuth2 Redirect
# ────────────────────────────────────
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth/callback
OAUTH2_FAILURE_REDIRECT_URI=http://localhost:3000/login?error=true

# ────────────────────────────────────
# CORS
# ────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ────────────────────────────────────
# OpenAI
# https://platform.openai.com/api-keys
# ────────────────────────────────────
OPENAI_API_KEY=<openai_api_key>
